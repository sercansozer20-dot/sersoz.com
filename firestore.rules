rules_version = '2';

/* =============================================================================
   sersoz.com — Cloud Firestore güvenlik kuralları
   Proje: sersoz-f93c3   ·   Bölge: eur3 (Avrupa)

   BU DOSYA ELLE YAYIMLANIR.
     Firebase Konsolu → Firestore Database → Rules → içeriği yapıştır → Publish.
   Dosya deponun içinde durur ki değişiklik geçmişi görülebilsin; GitHub Pages
   statik bir barındırma olduğu için dağıtım otomatik DEĞİLDİR.

   BU DOSYA TÜM VERİTABANINI KAPSAR. Yayınlamadan önce konsoldaki mevcut
   kurallarla karşılaştırın: forum bölümünün altında ziyaretler / urunler /
   siparisler / kullanicilar için var olan davranış birebir modellenmiştir.

   ---------------------------------------------------------------------------
   KURULUM ŞARTI (kurallardan SONRA, ilk gönderiden ÖNCE):

       forumAyar/genel  =  { yazmaAcik: true, yasakli: [] }

   Bu belge yoksa kural içindeki get() hata verir ve HİÇ KİMSE foruma yazamaz.
   Belgeyi elle oluşturabilirsiniz; ya da site sahibi hesabıyla /forum.html
   sayfasını açıp "Kurulum" kutusundaki düğmeye basmanız yeterlidir.
   ---------------------------------------------------------------------------
   İSTEMCİ SÖZLEŞMESİ (kurallar bunu zorunlu kılar, forum.html buna uyar):

     Konu açma   = writeBatch: set(forumKonular/{yeniId})
                              + set(forumHiz/{uid})
     Yanıt yazma = writeBatch: set(forumKonular/{k}/yanitlar/{yeniId})
                              + update(forumKonular/{k})   (sayaç + sonEtkinlik)
                              + set(forumHiz/{uid})

   Toplu yazmada request.time tüm işlemler için AYNIDIR; bütün zaman damgası
   eşitlikleri buna dayanır. Sayaç istemciden yazılmaz: increment(1) sunucu
   tarafında uygulanır, kural sonucu (eski + 1) olarak doğrular.
   ---------------------------------------------------------------------------
   DİZİNLER: forum.html tek alanlı sıralama kullanır
   (forumKonular orderBy sonEtkinlik DESC, yanitlar orderBy olusturma ASC).
   Bunlar Firestore'un otomatik tek-alan dizinleriyle karşılanır; ELLE DİZİN
   OLUŞTURMAK GEREKMEZ. Kategori süzgeci ve "çözülmüş" sekmesi istemcide,
   yüklenmiş sayfa üzerinde çalışır.

   Hacim büyüyünce (yüzlerce konu) sunucu tarafı süzmeye geçmek isterseniz
   şu bileşik dizinler gerekir — bugün gerekmez:
     (1) kategori ASC + sonEtkinlik DESC
     (2) gizli ASC   + sonEtkinlik DESC
     (3) cozuldu ASC + sonEtkinlik DESC
     (4) yazarUid ASC + olusturma DESC          (Hesabım > yazılarım / KVKK)
     (5) koleksiyon grubu: yanitlar → yazarUid ASC + olusturma DESC  (KVKK)
============================================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------------------------------------- ortak yardımcılar */

    function girisli()  { return request.auth != null; }
    function benim()    { return request.auth.uid; }
    function yeni()     { return request.resource.data; }
    function eski()     { return resource.data; }
    function degisenler() { return request.resource.data.diff(resource.data).affectedKeys(); }
    /* Kullanıcı metni: telefon (10+ hane), e-posta, iletişim yönlendirmesi ve ağır küfür içeremez. */
    function temizMetin(s) {
      let k = s.lower();
      return !s.matches('(?s).*([0-9][^0-9A-Za-z]{0,3}){9}[0-9].*')
        && !s.matches('(?s).*[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+[.][A-Za-z]{2,}.*')
        && !k.matches('(?s).*(whatsapp|watsap|vatsap|telegram|instagram|gmail|hotmail|numaram|telefonum|beni ara|bana ulaş|bana ulas|özelden|ozelden|iban|elden öde|elden ode|site dışı|site disi).*')
        && !k.matches('(?s)(.*[^a-zçğıöşü])?(amk|aq|ibne|piç|göt|oç|puşt|gavat)([^a-zçğıöşü].*)?')
        && !k.matches('(?s)(.*[^a-zçğıöşü])?(orospu|siktir|sikerim|sikeyim|yarrak|amına|amcık|pezevenk|kahpe|şerefsiz|yavşak|kaltak|sürtük|dalyarak).*');
    }

    function dogrulanmis() {
      return girisli()
             && request.auth.token.email is string
             && request.auth.token.email_verified == true;
    }

    function yonetici() {
      return girisli()
             && request.auth.token.email_verified == true
             && request.auth.token.email == 'sercansozer20@gmail.com';
    }

    /* Yazarın adı ve fotoğrafı İSTEMCİDEN DEĞİL, imzalı kimlik jetonundan gelir.
       Kullanıcı başkasının adıyla yazamaz; adını da uyduramaz. */
    function sunucuAd() {
      return ('name' in request.auth.token)
             && (request.auth.token.name is string)
             && (request.auth.token.name.size() > 0)
             && (request.auth.token.name.size() <= 80)
             ? request.auth.token.name
             : 'İsimsiz katılımcı';
    }

    function sunucuFoto() {
      return ('picture' in request.auth.token)
             && (request.auth.token.picture is string)
             && (request.auth.token.picture.size() <= 400)
             ? request.auth.token.picture
             : '';
    }

    /* --------------------------------------------------------- forum ortakları */

    function kategoriler() {
      return ['genel', 'plc-haberlesme', 'kamera-aydinlatma', '3d-vizyon',
              'goruntu-isleme', 'robotik', 'kalibrasyon', 'saha-sorunlari'];
    }

    /* "Adım görünmesin" seçeneği: gönderide görünen ad, gerçek ad yerine bu
       SABİT rol adlarından biri olabilir. Serbest metin verilmez — kullanıcı
       kendine "Yönetici" veya başkasının adını takamaz. Kimlik yine kayıtlıdır:
       yazarUid her zaman gerçek hesaptır ve site sahibi uid üzerinden
       kullanicilar/{uid} belgesinden kimin yazdığını görebilir. */
    function rolAdlari() {
      return ['Bakım Mühendisi', 'Otomasyon Mühendisi', 'Kalite Mühendisi',
              'PLC Programcısı', 'Sistem Entegratörü', 'Makine İmalatçısı',
              'Elektrik Teknisyeni', 'İsimsiz katılımcı'];
    }

    /* Görünen kimlik iki halden BİRİ olmak zorunda:
       açık kimlik  -> ad ve foto jetondan aynen,
       gizli kimlik -> ad sabit rol listesinden, foto boş. Arası yok. */
    function gorunenKimlik() {
      return (yeni().takmaMi == false
                && yeni().yazarAd   == sunucuAd()
                && yeni().yazarFoto == sunucuFoto())
          || (yeni().takmaMi == true
                && yeni().yazarAd in rolAdlari()
                && yeni().yazarFoto == '');
    }

    function ayarYolu() { return /databases/$(database)/documents/forumAyar/genel; }
    function hizYolu()  { return /databases/$(database)/documents/forumHiz/$(benim()); }

    /* Acil kilit + yasaklı kullanıcı — tek belge, tek okuma. */
    function forumAcik() {
      return get(ayarYolu()).data.yazmaAcik == true
             && !(benim() in get(ayarYolu()).data.yasakli);
    }

    function bugunKodu() {
      return request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }

    /* Gönderi ile aynı toplu yazmada hız belgesi damgalanmak ZORUNDA:
       sayaç kaçırılamaz. Ayrıca herkese açık yayın onayı burada aranır. */
    function hizDamgasi() {
      return getAfter(hizYolu()).data.sonYazi == request.time
             && getAfter(hizYolu()).data.forumOnay == true;
    }

    /* Önceki gönderinin üzerinden en az N saniye geçmiş olmalı. */
    function bekleme(saniye) {
      return !exists(hizYolu())
             || get(hizYolu()).data.sonYazi + duration.value(saniye, 's') < request.time;
    }

    function yazabilir(saniye) {
      return dogrulanmis() && forumAcik() && hizDamgasi() && bekleme(saniye);
    }

    /* =========================================================================
       1) FORUM AYARI — acil kilit ve yasak listesi
       Kural içindeki get() kuralları atladığı için bu belgenin herkese açık
       okunur olması gerekmez; yasaklı uid listesi gizli kalır.
    ========================================================================= */
    match /forumAyar/{belge} {
      allow read, write: if yonetici();
    }

    /* =========================================================================
       2) HIZ SINIRI / YAYIN ONAYI — kullanıcının kendi sayaç belgesi
    ========================================================================= */
    match /forumHiz/{kimlik} {

      function hizAlanlari() {
        return ['sonYazi', 'gunKodu', 'bugunSayi', 'forumOnay', 'onayZaman'];
      }

      allow read: if yonetici() || (girisli() && kimlik == benim());

      allow create: if dogrulanmis() && kimlik == benim()
        && yeni().keys().hasOnly(hizAlanlari())
        && yeni().keys().hasAll(hizAlanlari())
        && yeni().sonYazi   == request.time
        && yeni().gunKodu   == bugunKodu()
        && yeni().bugunSayi == 1
        && yeni().forumOnay is bool
        && yeni().onayZaman == request.time;

      allow update: if dogrulanmis() && kimlik == benim()
        && yeni().keys().hasOnly(hizAlanlari())
        && yeni().keys().hasAll(hizAlanlari())
        && yeni().sonYazi == request.time
        && yeni().gunKodu == bugunKodu()
        && yeni().forumOnay is bool
        && (yeni().onayZaman == eski().onayZaman || yeni().onayZaman == request.time)
        && yeni().bugunSayi is int
        && yeni().bugunSayi >= 1
        && yeni().bugunSayi <= 20                       /* GÜNLÜK TAVAN */
        && (eski().gunKodu == bugunKodu()
              ? yeni().bugunSayi == eski().bugunSayi + 1  /* aynı gün: tam +1  */
              : yeni().bugunSayi == 1);                   /* yeni gün: sıfırla */

      /* Kullanıcı sayacını silerek tavanı sıfırlayamaz. */
      allow delete: if yonetici();
    }

    /* =========================================================================
       3) FORUM PROFİLİ — herkese açık, e-posta İÇERMEZ
       (Şu an forum.html bu belgeyi yazmıyor; yazarın yanında "unvan · şehir"
        göstermek istendiğinde hazır olsun diye tanımlı bırakıldı. E-posta
        içeren kullanicilar/{uid} belgesi herkese açık okunamaz — forumun
        ihtiyaç duyduğu görünür bilgi için ayrı ve dar bir belge gerekir.)
    ========================================================================= */
    match /forumProfiller/{kimlik} {

      function profilAlanlari() {
        return ['uid', 'gorunenAd', 'unvan', 'firma', 'sehir', 'hakkinda', 'guncelleme'];
      }

      allow read: if true;

      allow create, update: if dogrulanmis() && kimlik == benim()
        && yeni().keys().hasOnly(profilAlanlari())
        && yeni().keys().hasAll(['uid', 'gorunenAd', 'guncelleme'])
        && yeni().uid == benim()
        && yeni().gorunenAd == sunucuAd()
        && (!('unvan'    in yeni()) || (yeni().unvan    is string && yeni().unvan.size()    <= 60))
        && (!('firma'    in yeni()) || (yeni().firma    is string && yeni().firma.size()    <= 60))
        && (!('sehir'    in yeni()) || (yeni().sehir    is string && yeni().sehir.size()    <= 40))
        && (!('hakkinda' in yeni()) || (yeni().hakkinda is string && yeni().hakkinda.size() <= 400))
        && yeni().guncelleme == request.time;

      allow delete: if yonetici() || (girisli() && kimlik == benim());
    }

    /* =========================================================================
       4) KONULAR
    ========================================================================= */
    match /forumKonular/{konuId} {

      /* NOT: 'etiketler' bilerek YOK. Ne istemci yazıyor ne de sayfa basıyordu;
         kural dilinde liste ELEMANLARI doğrulanamadığı için (foreach yok) izin
         verilen bir liste alanı, herkese açık bir belgeye sınırsız uzunlukta
         çöp yazmanın kapısıydı. İhtiyaç doğarsa eleman başına doğrulanabilen
         bir şekille (ör. sabit beyaz liste) geri eklenmeli. */
      function konuAlanlari() {
        return ['baslik', 'govde', 'kategori',
                'yazarUid', 'yazarAd', 'yazarFoto', 'takmaMi',
                'olusturma', 'sonEtkinlik', 'duzenleme', 'ilkYanit',
                'yanitSayisi', 'sonYanitId', 'sonYanitAd', 'sonYanitUid',
                'kilitli', 'gizli', 'sabitlenmis', 'cozuldu', 'cozumYanitId'];
      }

      function konuZorunlu() {
        return ['baslik', 'govde', 'kategori',
                'yazarUid', 'yazarAd', 'yazarFoto', 'takmaMi',
                'olusturma', 'sonEtkinlik', 'yanitSayisi',
                'sonYanitId', 'sonYanitAd', 'sonYanitUid',
                'kilitli', 'gizli', 'sabitlenmis', 'cozuldu'];
      }

      function metinGecerli() {
        return yeni().baslik is string
          && yeni().baslik.size() >= 10 && yeni().baslik.size() <= 120
          && yeni().govde is string
          && yeni().govde.size() >= 30 && yeni().govde.size() <= 8000
          && yeni().kategori in kategoriler();
      }

      /* Forum halka açık okunur — giriş yapmadan da okunur. */
      allow read: if true;

      allow create: if yazabilir(45)                     /* 45 sn konu beklemesi */
        && yeni().keys().hasOnly(konuAlanlari())
        && yeni().keys().hasAll(konuZorunlu())
        && metinGecerli()
        && yeni().yazarUid    == benim()                 /* uid uydurulamaz     */
        && gorunenKimlik()                               /* ad/foto ya jeton ya rol */
        && yeni().olusturma   == request.time            /* zaman sunucudan     */
        && yeni().sonEtkinlik == request.time
        && yeni().yanitSayisi == 0                       /* sayaç sıfır başlar  */
        && yeni().sonYanitId  == ''
        && yeni().sonYanitAd  == ''
        && yeni().sonYanitUid == ''
        && yeni().kilitli     == false                   /* kendini kilitleyip  */
        && yeni().gizli       == false                   /* moderasyondan kaçamaz */
        && yeni().sabitlenmis == false                   /* kendini öne alamaz  */
        && yeni().cozuldu     == false
        /* ÖLÇÜM ALANLARI CREATE'TE YASAK. ilkYanit sayfadaki "ölçülen ortanca
           ilk yanıt" rakamının tek kaynağıdır; create'te serbest bırakılırsa
           kullanıcı konusunu açarken ilkYanit'ı istediği ana yazıp UYDURMA bir
           ölçüm enjekte edebilirdi. Bu alan yalnız yanitSayaci() içinde,
           yalnız 0 -> 1 geçişinde ve yalnız request.time ile doğar.
           duzenleme / cozumYanitId de aynı sebeple sonradan doğar. */
        && !('ilkYanit'     in yeni())
        && !('duzenleme'    in yeni())
        && !('cozumYanitId' in yeni());

      /* --- güncelleme: üç ayrı meşru yol + yönetici --- */

      function yazarDuzenlemesi() {
        return dogrulanmis()
          && eski().yazarUid == benim()
          && eski().kilitli == false && eski().gizli == false
          && degisenler().hasOnly(['baslik', 'govde', 'kategori', 'duzenleme'])
          && metinGecerli()
          && yeni().duzenleme == request.time;
      }

      /* Yanıt sayacı: SAYAÇ MANİPÜLASYONUNA KARŞI KİLİT.
         Sayıyı bir artırmak, aynı toplu yazmada gerçekten bir yanıt belgesi
         yaratmayı gerektirir; getAfter() o belgenin yazma SONRASI halini okur.
         olusturma == request.time koşulu, eski bir yanıtı işaret ederek
         sayacı şişirmeyi de imkânsız kılar (eski belgenin damgası geçmişte).
         sonYanitAd yanıt belgesinden okunur — "adım görünmesin" seçilmişse
         gerçek ad listeye SIZMAZ. */
      function yanitBelgesi() {
        return getAfter(/databases/$(database)/documents/forumKonular/$(konuId)/yanitlar/$(yeni().sonYanitId)).data;
      }

      function yanitSayaci() {
        return dogrulanmis()
          && eski().kilitli == false && eski().gizli == false
          && degisenler().hasOnly(['yanitSayisi', 'sonEtkinlik', 'ilkYanit',
                                   'sonYanitId', 'sonYanitAd', 'sonYanitUid'])
          && yeni().yanitSayisi == eski().yanitSayisi + 1
          && yeni().sonEtkinlik == request.time
          && yeni().sonYanitUid == benim()
          && yeni().sonYanitId is string
          && yeni().sonYanitId.size() > 0
          && yeni().sonYanitId.size() <= 40
          && yanitBelgesi().yazarUid  == benim()
          && yanitBelgesi().olusturma == request.time
          && yanitBelgesi().yazarAd   == yeni().sonYanitAd
          /* ilkYanit yalnız 0 -> 1 geçişinde ve yalnız sunucu saatiyle yazılır;
             "ölçülen ilk yanıt süresi" bu alandan hesaplanır, uydurulamaz. */
          && (!degisenler().hasAny(['ilkYanit'])
              || (eski().yanitSayisi == 0 && yeni().ilkYanit == request.time));
      }

      /* Soruyu soran "çözüldü" işaretleyebilir; kilit/sabitleme yönetici işi.
         GİZLENMİŞ konuda çalışmaz: moderasyon kararı verilmiş bir konuyu yazar
         yeşil "Çözüldü" rozetiyle geri parlatamaz.
         cozumYanitId GERÇEK bir yanıtı göstermek zorunda — uydurma kimlik
         yazılıp "çözülmüş konu" sayacı şişirilemez. */
      function cozumIsareti() {
        return dogrulanmis()
          && eski().yazarUid == benim()
          && eski().gizli == false
          && degisenler().hasOnly(['cozuldu', 'cozumYanitId'])
          && yeni().cozuldu is bool
          && ('cozumYanitId' in yeni())
          && yeni().cozumYanitId is string
          && yeni().cozumYanitId.size() <= 40
          && (yeni().cozuldu == false
                ? yeni().cozumYanitId == ''
                : (yeni().cozumYanitId.size() > 0
                   && exists(/databases/$(database)/documents/forumKonular/$(konuId)/yanitlar/$(yeni().cozumYanitId))));
      }

      allow update: if yonetici()                        /* kilitle, gizle, sabitle */
                    || yazarDuzenlemesi()
                    || yanitSayaci()
                    || cozumIsareti();

      /* Yazar yalnız HİÇ YANIT ALMAMIŞ konusunu silebilir: başkalarının emeğini
         silemez ve öksüz alt koleksiyon bırakamaz. Yanıt almışsa yönetici siler
         (panel önce yanıtları, sonra konuyu silmeli — Firestore CASCADE YAPMAZ). */
      allow delete: if yonetici()
                    || (dogrulanmis() && eski().yazarUid == benim()
                        && eski().yanitSayisi == 0);

      /* --------------------------------------------------------- YANITLAR --- */
      match /yanitlar/{yanitId} {

        function yanitAlanlari() {
          return ['govde', 'yazarUid', 'yazarAd', 'yazarFoto', 'takmaMi',
                  'olusturma', 'duzenleme', 'silindi', 'yanitVerilen'];
        }

        function konuYolu() {
          return /databases/$(database)/documents/forumKonular/$(konuId);
        }

        allow read: if true;

        allow create: if yazabilir(20)                   /* 20 sn yanıt beklemesi */
          && exists(konuYolu())
          && get(konuYolu()).data.kilitli == false       /* KİLİTLİ KONUYA YAZILAMAZ */
          && get(konuYolu()).data.gizli   == false
          && yeni().keys().hasOnly(yanitAlanlari())
          && yeni().keys().hasAll(['govde', 'yazarUid', 'yazarAd', 'yazarFoto',
                                   'takmaMi', 'olusturma', 'silindi'])
          && yeni().govde is string
          && yeni().govde.size() >= 2 && yeni().govde.size() <= 4000
          && yeni().yazarUid == benim()
          && gorunenKimlik()
          && yeni().olusturma == request.time
          && yeni().silindi   == false
          && (!('yanitVerilen' in yeni())
              || (yeni().yanitVerilen is string && yeni().yanitVerilen.size() <= 40));

        /* Konu kilitli/gizli DEĞİLKEN metin düzeltilebilir. Bu kontrol şart:
           yoksa spam yüzünden kilitlenen/gizlenen bir konudaki yanıtın metni
           sonradan yenisiyle değiştirilebilir, moderasyon kararı boşa çıkardı. */
        function konuAcikMi() {
          return exists(konuYolu())
                 && get(konuYolu()).data.kilitli == false
                 && get(konuYolu()).data.gizli   == false;
        }

        /* Yazar ya metni düzeltir ya da yumuşak siler (govde boşalır, kayıt kalır).
           Yumuşak silme sayacın yalan söylemesini önler.
           YUMUŞAK SİLME kilitli/gizli konuda da serbesttir: kişinin kendi
           yazısını geri çekme hakkı (KVKK) moderasyona bağlanamaz. */
        allow update: if yonetici()
          || (dogrulanmis()
              && eski().yazarUid == benim()
              && eski().silindi == false
              && (
                   (degisenler().hasOnly(['govde', 'duzenleme'])
                     && konuAcikMi()
                     && yeni().govde is string
                     && yeni().govde.size() >= 2 && yeni().govde.size() <= 4000
                     && yeni().duzenleme == request.time)
                   ||
                   (degisenler().hasOnly(['govde', 'silindi', 'duzenleme'])
                     && yeni().silindi == true
                     && yeni().govde == ''
                     && yeni().duzenleme == request.time)
                 ));

        /* Kalıcı silme yalnız yöneticide (KVKK talebi, spam temizliği). */
        allow delete: if yonetici();
      }
    }

    /* Koleksiyon grubu sorgusu: collectionGroup('yanitlar') — bir kişinin tüm
       yanıtlarını bulmak için (KVKK dışa aktarma/anonimleştirme, profil sayfası).
       rules_version 2'de özyinelemeli joker olmadan grup sorgusu reddedilir.
       Yalnız OKUMA verir; yazma yukarıdaki dar kural üzerinden yürür. */
    match /{yol=**}/yanitlar/{yanitId} {
      allow read: if true;
    }

    /* =========================================================================
       5) ŞİKÂYET / BAYRAK — moderasyon kuyruğu
       Belge kimliği ZORUNLU olarak "{uid}__{hedefId}" — aynı kişi aynı hedefi
       ikinci kez bayraklarsa yeni belge oluşmaz, kuyruk şişirilemez.
    ========================================================================= */
    match /forumBayraklar/{bayrakId} {

      allow read, update, delete: if yonetici();

      allow create: if dogrulanmis()
        && bayrakId == benim() + '__' + yeni().hedefId
        && yeni().keys().hasOnly(['hedefTur', 'hedefId', 'konuId', 'sebep',
                                  'aciklama', 'bildirenUid', 'bildirenAd', 'olusturma'])
        && yeni().keys().hasAll(['hedefTur', 'hedefId', 'konuId', 'sebep',
                                 'bildirenUid', 'olusturma'])
        && yeni().hedefTur in ['konu', 'yanit']
        && yeni().hedefId is string && yeni().hedefId.size() > 0 && yeni().hedefId.size() <= 40
        && yeni().konuId  is string && yeni().konuId.size()  > 0 && yeni().konuId.size()  <= 40
        && yeni().sebep in ['spam', 'taciz', 'reklam', 'alakasiz', 'kisisel-veri', 'telif', 'diger']
        && (!('aciklama' in yeni())
            || (yeni().aciklama is string && yeni().aciklama.size() <= 500))
        && yeni().bildirenUid == benim()
        && (!('bildirenAd' in yeni()) || yeni().bildirenAd == sunucuAd())
        && yeni().olusturma == request.time;
    }

    /* =========================================================================
       MEVCUT KOLEKSİYONLAR — forumdan önce de vardı, davranış korunuyor
    ========================================================================= */

    /* iz.js: kimliksiz REST yazımı. Yazma serbest ama ŞEKİL zorunlu; okuma yok
       (ziyaret kayıtları yalnız yöneticiye). */
    match /ziyaretler/{kayit} {
      allow create: if yeni().keys().hasOnly(['sayfa', 'zaman', 'kaynak',
                                              'genislik', 'dil', 'oturum', 'olay'])
        && yeni().sayfa  is string && yeni().sayfa.size()  <= 120
        && yeni().kaynak is string && yeni().kaynak.size() <= 120
        && yeni().dil    is string && yeni().dil.size()    <= 12
        && yeni().oturum is string && yeni().oturum.size() <= 40
        && yeni().olay in ['giris', 'cikis']
        && yeni().genislik is int && yeni().genislik >= 0 && yeni().genislik <= 20000
        && yeni().zaman is timestamp;
      allow read, update, delete: if yonetici();
    }

    /* Mağaza kataloğu: herkes okur, yalnız yönetici yazar. */
    match /urunler/{urun} {
      allow read: if true;
      allow write: if yonetici();
    }

    /* Siparişler: kullanıcı yalnız kendi siparişini yaratır ve okur. */
    match /siparisler/{siparis} {
      allow create: if girisli()
                    && yeni().ownerId == benim()
                    && yeni().tarih == request.time;
      allow read:   if yonetici() || (girisli() && eski().ownerId == benim());
      allow update, delete: if yonetici();
    }

    /* Hesap kaydı (hesap.js) ve kayıtlı adresler. E-POSTA BURADA — herkese açık
       okunmaz; forumun ihtiyaç duyduğu görünür bilgi konu/yanıt belgesindedir.
       NOT: hasOnly listesi hesap.js ile birebir; hesap.js'e yeni alan eklenirse
       bu liste de güncellenmeli, yoksa giriş sırasında yazma sessizce reddedilir. */
    match /kullanicilar/{kimlik} {
      allow read: if yonetici() || (girisli() && kimlik == benim());

      allow create, update: if girisli() && kimlik == benim()
        && yeni().keys().hasOnly(['uid', 'eposta', 'ad', 'foto', 'sonGiris'])
        && yeni().uid == benim()
        && yeni().eposta == request.auth.token.email
        && yeni().sonGiris == request.time;

      allow delete: if yonetici() || (girisli() && kimlik == benim());

      match /adresler/{adres} {
        allow read, write: if girisli() && kimlik == benim();
        allow read, delete: if yonetici();
      }
    }

    /* =====================================================================
       ELİF'İN DOLABI — kişiden kişiye kıyafet kiralama (elif.html, elif.js)
       Ödeme site işletmecisine yapılır; yönetici "ödendi" işaretler.
       Durum akışı (kim değiştirir):
         beklemede ─sahip→ onaylandi ─kiracı→ odeme_bildirildi ─yönetici→ odendi
             │                 │                     └─yönetici→ onaylandi (ödeme bulunamadı)
             ├─sahip→ reddedildi
             └─kiracı→ iptal ←─kiracı─┘
         odendi ─sahip→ teslim_edildi ─sahip→ iade_edildi
       Liste sorguları tek alanla süzülür (sahipId / kiraciId / aktif / durum);
       sıralama istemcide yapılır → bileşik dizin GEREKMEZ.
       ===================================================================== */
    /* Yetki: tam yetkili sabit e-posta; adminler ve kısıtlılar dolapRoller/{gmail} belgesinde.
       Admin atamayı yalnız tam yetkili yapar; adminler yalnız normal kullanıcıyı kısıtlar. */
    function tamYetkili() {
      return girisli() && request.auth.token.email_verified == true
             && request.auth.token.email == 'sercansozer20@gmail.com';
    }
    function rolYolu() { return /databases/$(database)/documents/dolapRoller/$(request.auth.token.email); }
    function dolapAdmin() {
      return tamYetkili() || (girisli() && request.auth.token.email_verified == true
             && exists(rolYolu()) && get(rolYolu()).data.rol == 'admin');
    }
    function kisitli() {
      return girisli() && exists(rolYolu()) && get(rolYolu()).data.rol == 'kisitli';
    }

    function dolapAlanlari() {
      return ['sahipId', 'sahipAd', 'sahipFoto', 'baslik', 'marka', 'kategori', 'beden',
              'renk', 'aciklama', 'gunlukUcret', 'depozito', 'fotolar', 'fotoBelge', 'begeni', 'onayZaman', 'puanToplam', 'puanAdet', 'dolu', 'olculer', 'aktif', 'olusturma', 'sozlesme', 'onay', 'redNeden', 'oneCikanBitis'];
    }
    function esyaGecerli() {
      let d = request.resource.data;
      return d.keys().hasOnly(dolapAlanlari())
        && d.baslik is string && d.baslik.size() >= 2 && d.baslik.size() <= 80
        && d.marka is string && d.marka.size() <= 40
        && d.kategori in ['elbise', 'ust', 'alt', 'dis-giyim', 'ayakkabi', 'canta', 'aksesuar', 'diger']
        && d.beden is string && d.beden.size() <= 12
        && d.renk is string && d.renk.size() <= 30
        && d.aciklama is string && d.aciklama.size() <= 1000
        && d.gunlukUcret is number && d.gunlukUcret > 0 && d.gunlukUcret <= 100000
        && d.depozito is number && d.depozito >= 0 && d.depozito <= 1000000
        && d.fotolar is list && d.fotolar.size() >= 1 && d.fotolar.size() <= 4
        && d.fotolar[0] is string && d.fotolar[0].size() <= 120000
        && (!d.keys().hasAny(['fotoBelge']) || (d.fotoBelge is list && d.fotoBelge.size() <= 4))
        && (!d.keys().hasAny(['dolu']) || (d.dolu is list && d.dolu.size() <= 60))
        && (!d.keys().hasAny(['olculer']) || (d.olculer is map && d.olculer.size() <= 6))
        && d.aktif is bool
        && d.sozlesme == 'v1'
        && d.onay in ['bekliyor', 'onaylandi', 'reddedildi']
        && d.redNeden is string && d.redNeden.size() <= 200
        && (d.get('oneCikanBitis', null) == null || d.oneCikanBitis is timestamp)
        && d.sahipAd is string && d.sahipAd.size() <= 80
        && d.sahipFoto is string && d.sahipFoto.size() <= 600;
    }

    match /dolapEsyalar/{esya} {
      allow read: if resource.data.onay == 'onaylandi'
        || (girisli() && (resource.data.sahipId == benim() || dolapAdmin()));
      allow create: if girisli() && !kisitli() && esyaGecerli()
        && yeni().sahipId == benim()
        && yeni().onay == 'bekliyor' && yeni().redNeden == ''
        && temizMetin(yeni().baslik) && temizMetin(yeni().aciklama)
        && yeni().olusturma == request.time;
      /* sahip: yalnız yayın aç/kapa, ya da içerik değişikliği → yeniden onaya */
      allow update: if girisli() && eski().sahipId == benim() && !kisitli() && esyaGecerli()
        && yeni().sahipId == eski().sahipId
        && yeni().olusturma == eski().olusturma
        && !degisenler().hasAny(['oneCikanBitis', 'begeni', 'onayZaman', 'puanToplam', 'puanAdet'])
        && (degisenler().hasOnly(['aktif', 'dolu'])
            || (yeni().onay == 'bekliyor' && yeni().redNeden == '' && temizMetin(yeni().baslik) && temizMetin(yeni().aciklama)));
      /* beğeni sayacı: yalnız ±1 ve aynı yazımda kişinin beğeni kaydı eklenip/silinirse */
      allow update: if girisli() && !kisitli() && degisenler().hasOnly(['begeni'])
        && ((yeni().begeni == eski().get('begeni', 0) + 1
             && !exists(/databases/$(database)/documents/dolapBegeniler/$(esya + '_' + benim()))
             && existsAfter(/databases/$(database)/documents/dolapBegeniler/$(esya + '_' + benim())))
          || (yeni().begeni == eski().get('begeni', 0) - 1
             && exists(/databases/$(database)/documents/dolapBegeniler/$(esya + '_' + benim()))
             && !existsAfter(/databases/$(database)/documents/dolapBegeniler/$(esya + '_' + benim()))));
      /* gerçek yorum: puan toplamı yalnız yorum kaydıyla aynı yazımda artar; admin yorum silerken azaltır */
      allow update: if girisli() && degisenler().hasOnly(['puanToplam', 'puanAdet'])
        && ((yeni().puanAdet == eski().get('puanAdet', 0) + 1
             && !exists(/databases/$(database)/documents/dolapYorumlar/$(esya + '_' + benim()))
             && existsAfter(/databases/$(database)/documents/dolapYorumlar/$(esya + '_' + benim()))
             && yeni().puanToplam == eski().get('puanToplam', 0) + getAfter(/databases/$(database)/documents/dolapYorumlar/$(esya + '_' + benim())).data.puan)
          || (dolapAdmin() && yeni().puanAdet == eski().get('puanAdet', 0) - 1));
      /* admin: onay / red / yayından kaldırma */
      allow update: if dolapAdmin() && esyaGecerli()
        && degisenler().hasOnly(['onay', 'redNeden', 'aktif', 'oneCikanBitis', 'onayZaman'])
        && (!degisenler().hasAny(['onayZaman']) || yeni().onayZaman == request.time);
      allow delete: if girisli() && (eski().sahipId == benim() || dolapAdmin());
    }

    function kiraEsyasi() {
      return get(/databases/$(database)/documents/dolapEsyalar/$(request.resource.data.esyaId)).data;
    }
    function kiraGecis() {
      let e = resource.data.durum;
      let y = request.resource.data.durum;
      let sahip = resource.data.sahipId == benim();
      let kiraci = resource.data.kiraciId == benim();
      return request.resource.data.guncelleme == request.time && (
        (sahip && e == 'beklemede' && y == 'onaylandi'
          && degisenler().hasOnly(['durum', 'guncelleme', 'sahipIletisim', 'sahipSozlesme'])
          && request.resource.data.sahipSozlesme == 'v1'
          && request.resource.data.sahipIletisim is string
          && request.resource.data.sahipIletisim.size() >= 5
          && request.resource.data.sahipIletisim.size() <= 200)
        || (dolapAdmin() && (tamYetkili() || !(sahip || kiraci)) && e == 'odeme_bildirildi' && y == 'odendi'
          && degisenler().hasOnly(['durum', 'guncelleme', 'odemeZaman', 'alinanTutar'])
          && request.resource.data.odemeZaman == request.time
          && request.resource.data.alinanTutar is int && request.resource.data.alinanTutar > 0)
        || (kiraci && e == 'teslim_edildi' && y == 'iade_yolda'
          && degisenler().hasOnly(['durum', 'guncelleme', 'iadeFirma', 'iadeTakip', 'iadeZaman'])
          && request.resource.data.iadeFirma is string && request.resource.data.iadeFirma.size() >= 2
          && request.resource.data.iadeFirma.size() <= 40
          && request.resource.data.iadeTakip is string && request.resource.data.iadeTakip.size() <= 40
          && request.resource.data.iadeZaman == request.time)
        || (sahip && e in ['teslim_edildi', 'iade_yolda'] && y == 'iade_edildi'
          && degisenler().hasOnly(['durum', 'guncelleme', 'iadeDurum'])
          && request.resource.data.get('iadeDurum', 'sorunsuz') in ['sorunsuz', 'gec', 'hasar'])
        || (sahip && e == 'odendi' && y == 'kargoda'
          && degisenler().hasOnly(['durum', 'guncelleme', 'kargoFirma', 'kargoTakip', 'kargoZaman'])
          && request.resource.data.kargoFirma is string && request.resource.data.kargoFirma.size() >= 2
          && request.resource.data.kargoFirma.size() <= 40
          && request.resource.data.kargoTakip is string && request.resource.data.kargoTakip.size() <= 40
          && request.resource.data.kargoZaman == request.time)
        || (e == 'kargoda' && y == 'teslim_edildi'
          && degisenler().hasOnly(['durum', 'guncelleme', 'teslimOnay'])
          && ((kiraci && request.resource.data.teslimOnay == 'kiraci')
              || (dolapAdmin() && (tamYetkili() || !(sahip || kiraci)) && request.resource.data.teslimOnay == 'admin')))
        || (kiraci && e == y && e in ['kargoda', 'teslim_edildi']
          && degisenler().hasOnly(['guncelleme', 'teslimSorun', 'sorunDurum'])
          && request.resource.data.get('sorunDurum', 'acik') == 'acik'
          && request.resource.data.teslimSorun is string && request.resource.data.teslimSorun.size() <= 300)
        || (degisenler().hasOnly(['durum', 'guncelleme', 'iptalNeden'])
          && request.resource.data.get('iptalNeden', '') is string && request.resource.data.get('iptalNeden', '').size() <= 200 && (
             (sahip && e == 'beklemede' && y == 'reddedildi')
          || (sahip && e == 'onaylandi' && y == 'iptal')
          || (kiraci && e in ['beklemede', 'onaylandi'] && y == 'iptal')
          || (kiraci && e == 'onaylandi' && y == 'odeme_bildirildi')
          || (dolapAdmin() && (tamYetkili() || !(sahip || kiraci)) && e == 'odeme_bildirildi' && y in ['odendi', 'onaylandi'])
        ))
      );
    }

    /* Gelir oranları (ayarlarGenel/gelir); belge yoksa 0. */
    function gelirOrani(alan) {
      let y = /databases/$(database)/documents/ayarlarGenel/gelir;
      return exists(y) ? get(y).data.get(alan, 0) : 0;
    }
    /* Admin: eşya sahibine ödeme ve depozito iadesi kaydı (teslimden sonra). */
    function odemeTakip() {
      return dolapAdmin() && (tamYetkili() || (resource.data.kiraciId != benim() && resource.data.sahipId != benim()))
        && request.resource.data.guncelleme == request.time
        && degisenler().hasOnly(['sahipOdeme', 'sahipOdemeZaman', 'depozitoDurum', 'depozitoKesinti', 'depozitoNot', 'depozitoZaman',
                                 'komisyonAlindi', 'komisyonTutar', 'komisyonZaman', 'guncelleme'])
        && (!degisenler().hasAny(['sahipOdeme']) || request.resource.data.get('komisyonAlindi', false) == true)
        && (!degisenler().hasAny(['sahipOdeme']) || !('teslimSorun' in resource.data) || resource.data.get('sorunDurum', 'acik') == 'cozuldu')
        && (!degisenler().hasAny(['komisyonAlindi'])
            || (request.resource.data.komisyonAlindi == true && request.resource.data.komisyonTutar is int
                && request.resource.data.komisyonZaman == request.time))
        && resource.data.durum in ['teslim_edildi', 'iade_yolda', 'iade_edildi'];
    }

    /* Yönetim müdahalesi: admin (kiralamada taraf değilse; tam yetkili her zaman) durumu gerekçeyle değiştirir,
       siparişi iptal eder ya da sorunu çözüldü olarak kapatır. */
    function yonetimMudahale() {
      return dolapAdmin() && (tamYetkili() || (resource.data.kiraciId != benim() && resource.data.sahipId != benim()))
        && request.resource.data.guncelleme == request.time
        && degisenler().hasOnly(['durum', 'guncelleme', 'yonetimNot', 'iptalNeden', 'teslimOnay', 'sorunDurum', 'sorunNot'])
        && request.resource.data.durum in ['beklemede', 'onaylandi', 'odeme_bildirildi', 'odendi', 'kargoda', 'teslim_edildi', 'iade_yolda', 'iade_edildi', 'reddedildi', 'iptal']
        && request.resource.data.get('yonetimNot', '') is string && request.resource.data.get('yonetimNot', '').size() <= 300
        && request.resource.data.get('sorunNot', '') is string && request.resource.data.get('sorunNot', '').size() <= 300
        && request.resource.data.get('sorunDurum', 'acik') in ['acik', 'cozuldu'];
    }

    /* Admin: kiracıya kartla ödeme linki (Shopier) ekler. */
    function kartLinki() {
      return dolapAdmin() && (tamYetkili() || (resource.data.kiraciId != benim() && resource.data.sahipId != benim()))
        && request.resource.data.guncelleme == request.time
        && degisenler().hasOnly(['kartLink', 'guncelleme'])
        && resource.data.durum in ['onaylandi', 'odeme_bildirildi']
        && request.resource.data.kartLink is string && request.resource.data.kartLink.size() <= 300
        && (request.resource.data.kartLink == '' || request.resource.data.kartLink.matches('^https://(www[.])?shopier[.]com/.+'));
    }

    /* Teslimat adresi: kiralamayla aynı yazımda kiracı oluşturur. Eşya sahibi yalnız ödeme
       admin tarafından onaylandıktan sonra (odendi ve sonrası) okuyabilir. */
    match /dolapKiraGizli/{kira} {
      allow create: if girisli()
        && yeni().keys().hasOnly(['adres', 'kiraciId', 'sahipId'])
        && yeni().kiraciId == benim()
        && yeni().adres is string && yeni().adres.size() >= 3 && yeni().adres.size() <= 400
        && !exists(/databases/$(database)/documents/dolapKiralamalar/$(kira))
        && getAfter(/databases/$(database)/documents/dolapKiralamalar/$(kira)).data.kiraciId == benim()
        && getAfter(/databases/$(database)/documents/dolapKiralamalar/$(kira)).data.sahipId == yeni().sahipId;
      allow read: if girisli() && (resource.data.kiraciId == benim() || dolapAdmin()
        || (resource.data.sahipId == benim()
            && get(/databases/$(database)/documents/dolapKiralamalar/$(kira)).data.durum in ['odendi', 'kargoda', 'teslim_edildi', 'iade_yolda', 'iade_edildi']));
      allow update, delete: if tamYetkili();
    }

    /* İade adresi: eşya sahibi, kiralamayı "kargoda"ya geçirdiği aynı yazımda oluşturur.
       Kiracı parça kargoya çıktıktan sonra okur. */
    match /dolapIadeAdres/{kira} {
      allow create: if girisli()
        && yeni().keys().hasOnly(['adres', 'sahipId', 'kiraciId'])
        && yeni().sahipId == benim()
        && yeni().adres is string && yeni().adres.size() >= 3 && yeni().adres.size() <= 400
        && get(/databases/$(database)/documents/dolapKiralamalar/$(kira)).data.durum == 'odendi'
        && get(/databases/$(database)/documents/dolapKiralamalar/$(kira)).data.sahipId == benim()
        && get(/databases/$(database)/documents/dolapKiralamalar/$(kira)).data.kiraciId == yeni().kiraciId
        && getAfter(/databases/$(database)/documents/dolapKiralamalar/$(kira)).data.durum == 'kargoda';
      allow read: if girisli() && (resource.data.sahipId == benim() || dolapAdmin()
        || (resource.data.kiraciId == benim()
            && get(/databases/$(database)/documents/dolapKiralamalar/$(kira)).data.durum in ['kargoda', 'teslim_edildi', 'iade_yolda', 'iade_edildi']));
      allow update, delete: if tamYetkili();
    }

    /* Siteden kaldırılan örnek ilanların kimlikleri (adminler ekler). */
    match /ayarlarGenel/ornekGizli {
      allow read: if true;
      allow write: if dolapAdmin() && yeni().keys().hasOnly(['idler'])
        && yeni().idler is list && yeni().idler.size() <= 500;
    }

    match /ayarlarGenel/gelir {
      allow read: if true;
      allow write: if tamYetkili() && yeni().keys().hasOnly(['hizmetYuzde', 'komisyonYuzde'])
        && yeni().hizmetYuzde is int && yeni().hizmetYuzde >= 0 && yeni().hizmetYuzde <= 30
        && yeni().komisyonYuzde is int && yeni().komisyonYuzde >= 0 && yeni().komisyonYuzde <= 30;
    }

    match /dolapKiralamalar/{kira} {
      allow read: if girisli()
        && (eski().kiraciId == benim() || eski().sahipId == benim() || dolapAdmin());
      allow create: if girisli()
        && yeni().keys().hasOnly(['esyaId', 'esyaBaslik', 'esyaFoto', 'sahipId', 'kiraciId',
             'kiraciAd', 'kiraciIletisim', 'sahipIletisim', 'baslangic', 'bitis', 'gun',
             'gunlukUcret', 'kira', 'depozito', 'toplam', 'not', 'durum', 'olusturma', 'guncelleme', 'sozlesme',
             'indirimYuzde', 'indirim', 'hizmetYuzde', 'hizmetBedeli', 'komisyonYuzde'])
        && yeni().sozlesme == 'v1'
        && yeni().kiraciId == benim()
        && yeni().sahipId != benim()
        && yeni().durum == 'beklemede'
        && yeni().sahipIletisim == ''
        && yeni().olusturma == request.time && yeni().guncelleme == request.time
        && !kisitli()
        && kiraEsyasi().aktif == true
        && kiraEsyasi().onay == 'onaylandi'
        && kiraEsyasi().sahipId == yeni().sahipId
        && kiraEsyasi().gunlukUcret == yeni().gunlukUcret
        && kiraEsyasi().depozito == yeni().depozito
        && yeni().gun is int && yeni().gun >= 1 && yeni().gun <= 60
        && yeni().get('indirimYuzde', 0) is int && yeni().get('indirimYuzde', 0) >= 0 && yeni().get('indirimYuzde', 0) <= 30
        && yeni().get('indirim', 0) is int
        && yeni().get('indirim', 0) * 100 <= yeni().gun * yeni().gunlukUcret * yeni().get('indirimYuzde', 0)
        && (yeni().get('indirim', 0) + 1) * 100 > yeni().gun * yeni().gunlukUcret * yeni().get('indirimYuzde', 0)
        && yeni().kira == yeni().gun * yeni().gunlukUcret - yeni().get('indirim', 0)
        && yeni().get('hizmetYuzde', 0) == gelirOrani('hizmetYuzde')
        && yeni().get('komisyonYuzde', 0) == gelirOrani('komisyonYuzde')
        && yeni().get('hizmetBedeli', 0) is int
        && yeni().get('hizmetBedeli', 0) * 100 <= yeni().gun * yeni().gunlukUcret * yeni().get('hizmetYuzde', 0)
        && (yeni().get('hizmetBedeli', 0) + 1) * 100 > yeni().gun * yeni().gunlukUcret * yeni().get('hizmetYuzde', 0)
        && yeni().toplam == yeni().kira + yeni().get('hizmetBedeli', 0) + yeni().depozito
        && yeni().baslangic is string && yeni().baslangic.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && yeni().bitis is string && yeni().bitis.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && yeni().bitis > yeni().baslangic
        && yeni().esyaBaslik is string && yeni().esyaBaslik.size() <= 80
        && yeni().esyaFoto is string && yeni().esyaFoto.size() <= 120000
        && yeni().kiraciAd is string && yeni().kiraciAd.size() <= 80
        && yeni().kiraciIletisim is string && yeni().kiraciIletisim.size() >= 5
        && yeni().kiraciIletisim.size() <= 200
        && yeni().not is string && yeni().not.size() <= 500
        && temizMetin(yeni().not);
      allow update: if girisli() && (kiraGecis() || odemeTakip() || kartLinki() || yonetimMudahale());
      allow delete: if tamYetkili();
    }

    /* Parça fotoğrafları (tam boy, sıkıştırılmış JPEG data URL). Herkes okur; sahibi ekler/siler, admin silebilir. */
    match /dolapBegeniler/{begeni} {
      allow read: if girisli() && resource.data.uid == benim();
      allow create: if girisli() && !kisitli()
        && yeni().keys().hasOnly(['esyaId', 'uid', 'zaman'])
        && yeni().uid == benim() && begeni == yeni().esyaId + '_' + benim()
        && yeni().zaman == request.time
        && getAfter(/databases/$(database)/documents/dolapEsyalar/$(yeni().esyaId)).data.get('begeni', 0)
           == get(/databases/$(database)/documents/dolapEsyalar/$(yeni().esyaId)).data.get('begeni', 0) + 1;
      allow delete: if girisli() && resource.data.uid == benim()
        && getAfter(/databases/$(database)/documents/dolapEsyalar/$(resource.data.esyaId)).data.get('begeni', 0)
           == get(/databases/$(database)/documents/dolapEsyalar/$(resource.data.esyaId)).data.get('begeni', 0) - 1;
    }

    /* Borç / alacak kayıtları: admin açar ve kapatır; kişi kendisininkini görür, borcunu ödediğini bildirir. */
    match /dolapBorclar/{borc} {
      allow read: if girisli() && (resource.data.kisiId == benim() || dolapAdmin());
      allow create: if dolapAdmin()
        && yeni().keys().hasOnly(['kiraId', 'esyaBaslik', 'tur', 'kisiId', 'kisiAd', 'tutar', 'neden', 'durum', 'bildirildi', 'olusturma', 'yazan'])
        && yeni().tur in ['kiraci_site', 'sahip_site', 'site_sahip', 'site_kiraci']
        && yeni().tutar is int && yeni().tutar > 0 && yeni().tutar <= 1000000
        && yeni().neden is string && yeni().neden.size() <= 200
        && yeni().durum == 'acik' && yeni().bildirildi == false
        && yeni().yazan == request.auth.token.email && yeni().olusturma == request.time
        && (tamYetkili() || yeni().kisiId != benim());
      allow update: if (dolapAdmin() && (tamYetkili() || resource.data.kisiId != benim())
            && degisenler().hasOnly(['durum', 'kapanis']) && yeni().durum == 'kapandi' && yeni().kapanis == request.time)
        || (girisli() && resource.data.kisiId == benim() && resource.data.tur in ['kiraci_site', 'sahip_site']
            && resource.data.durum == 'acik'
            && degisenler().hasOnly(['bildirildi', 'guncelleme']) && yeni().bildirildi == true);
      allow delete: if tamYetkili();
    }

    /* Kasa: elle giriş/çıkış kayıtları. Adminler görür, yalnız tam yetkili yazar. */
    match /dolapKasa/{hareket} {
      allow read: if dolapAdmin();
      allow create: if tamYetkili()
        && yeni().keys().hasOnly(['tur', 'tutar', 'aciklama', 'olusturma', 'yazan'])
        && yeni().tur in ['giris', 'cikis']
        && yeni().tutar is int && yeni().tutar > 0 && yeni().tutar <= 10000000
        && yeni().aciklama is string && yeni().aciklama.size() >= 3 && yeni().aciklama.size() <= 200
        && yeni().olusturma == request.time && yeni().yazan == request.auth.token.email;
      allow delete: if tamYetkili();
    }

    /* Satıcıya sor: herkes okur; giriş yapan sorar, eşya sahibi bir kez cevaplar. */
    match /dolapSorular/{soru} {
      allow read: if true;
      allow create: if girisli() && !kisitli()
        && yeni().keys().hasOnly(['esyaId', 'esyaBaslik', 'sahipId', 'soranId', 'soranAd', 'soru', 'cevap', 'durum', 'olusturma'])
        && yeni().soranId == benim() && yeni().sahipId != benim()
        && get(/databases/$(database)/documents/dolapEsyalar/$(yeni().esyaId)).data.sahipId == yeni().sahipId
        && yeni().soru is string && yeni().soru.size() >= 3 && yeni().soru.size() <= 500 && temizMetin(yeni().soru)
        && yeni().soranAd is string && yeni().soranAd.size() <= 40
        && yeni().esyaBaslik is string && yeni().esyaBaslik.size() <= 80
        && yeni().cevap == '' && yeni().durum == 'bekliyor' && yeni().olusturma == request.time;
      allow update: if girisli() && resource.data.sahipId == benim() && resource.data.durum == 'bekliyor'
        && degisenler().hasOnly(['cevap', 'durum', 'cevapZaman'])
        && yeni().cevap is string && yeni().cevap.size() >= 1 && yeni().cevap.size() <= 1000 && temizMetin(yeni().cevap)
        && yeni().durum == 'cevaplandi' && yeni().cevapZaman == request.time;
      allow delete: if girisli() && ((resource.data.soranId == benim() && resource.data.durum == 'bekliyor') || dolapAdmin());
    }

    /* Kiralama işlem kaydı: değişikliği yapan taraf/admin aynı yazımda ekler; değiştirilemez, silinemez (tam yetkili hariç). */
    match /dolapKiraLog/{log} {
      allow read: if girisli() && (resource.data.kiraciId == benim() || resource.data.sahipId == benim() || dolapAdmin());
      allow create: if girisli()
        && yeni().keys().hasOnly(['kiraId', 'sahipId', 'kiraciId', 'olay', 'metin', 'kim', 'kimAd', 'rol', 'zaman'])
        && yeni().kim == benim() && yeni().zaman == request.time
        && yeni().olay is string && yeni().olay.size() <= 40 && yeni().metin is string && yeni().metin.size() <= 300
        && yeni().rol in ['kiraci', 'sahip', 'admin'] && (yeni().rol != 'admin' || dolapAdmin())
        && getAfter(/databases/$(database)/documents/dolapKiralamalar/$(yeni().kiraId)).data.kiraciId == yeni().kiraciId
        && getAfter(/databases/$(database)/documents/dolapKiralamalar/$(yeni().kiraId)).data.sahipId == yeni().sahipId
        && (yeni().kiraciId == benim() || yeni().sahipId == benim() || dolapAdmin());
      allow delete: if tamYetkili();
    }
    /* Siparişe yönetimin iç notları (taraflar görmez) */
    match /dolapKiraNot/{n} {
      allow read: if dolapAdmin();
      allow create: if dolapAdmin() && yeni().keys().hasOnly(['kiraId', 'metin', 'yazan', 'yazanAd', 'zaman'])
        && yeni().yazan == request.auth.token.email && yeni().zaman == request.time
        && yeni().metin is string && yeni().metin.size() >= 2 && yeni().metin.size() <= 1000;
      allow delete: if tamYetkili();
    }

    /* Gerçek yorumlar: belge kimliği esyaId_uid (parça başına bir yorum). Yalnız parçayı kiralayıp iade etmiş kiracı yazar. */
    match /dolapYorumlar/{yorum} {
      allow read: if true;
      allow create: if girisli() && !kisitli()
        && yeni().keys().hasOnly(['esyaId', 'kiraId', 'sahipId', 'uid', 'ad', 'foto', 'puan', 'metin', 'tarih'])
        && yorum == yeni().esyaId + '_' + benim() && yeni().uid == benim() && yeni().tarih == request.time
        && yeni().puan is int && yeni().puan >= 1 && yeni().puan <= 5
        && yeni().metin is string && yeni().metin.size() >= 5 && yeni().metin.size() <= 500 && temizMetin(yeni().metin)
        && yeni().ad is string && yeni().ad.size() <= 40 && yeni().foto is string && yeni().foto.size() <= 600
        && get(/databases/$(database)/documents/dolapKiralamalar/$(yeni().kiraId)).data.kiraciId == benim()
        && get(/databases/$(database)/documents/dolapKiralamalar/$(yeni().kiraId)).data.esyaId == yeni().esyaId
        && get(/databases/$(database)/documents/dolapKiralamalar/$(yeni().kiraId)).data.sahipId == yeni().sahipId
        && get(/databases/$(database)/documents/dolapKiralamalar/$(yeni().kiraId)).data.durum == 'iade_edildi'
        && getAfter(/databases/$(database)/documents/dolapEsyalar/$(yeni().esyaId)).data.get('puanAdet', 0)
           == get(/databases/$(database)/documents/dolapEsyalar/$(yeni().esyaId)).data.get('puanAdet', 0) + 1;
      allow delete: if dolapAdmin();
    }

    /* "Aradığını bulamadın mı?" talepleri: herkes okur (eşya sahipleri görsün), giriş yapan yazar. */
    match /dolapTalepler/{talep} {
      allow read: if true;
      allow create: if girisli() && !kisitli()
        && yeni().keys().hasOnly(['uid', 'ad', 'metin', 'beden', 'kategori', 'olusturma'])
        && yeni().uid == benim() && yeni().olusturma == request.time
        && yeni().metin is string && yeni().metin.size() >= 3 && yeni().metin.size() <= 120 && temizMetin(yeni().metin)
        && yeni().beden is string && yeni().beden.size() <= 12 && temizMetin(yeni().beden)
        && yeni().ad is string && yeni().ad.size() <= 40 && yeni().kategori is string && yeni().kategori.size() <= 20;
      allow delete: if girisli() && (resource.data.uid == benim() || dolapAdmin());
    }
    /* Dolap takibi: belge kimliği takipEden_sahip */
    match /dolapTakip/{takip} {
      allow read: if true;
      allow create: if girisli() && yeni().keys().hasOnly(['uid', 'sahipId', 'zaman'])
        && yeni().uid == benim() && yeni().sahipId != benim() && takip == benim() + '_' + yeni().sahipId
        && yeni().zaman == request.time;
      allow delete: if girisli() && resource.data.uid == benim();
    }

    /* Şikâyetler (App Store 1.2): giriş yapan yazar, yalnız yönetim okur ve kapatır. */
    match /dolapSikayetler/{sikayet} {
      allow read: if dolapAdmin();
      allow create: if girisli()
        && yeni().keys().hasOnly(['tur', 'hedefId', 'hedefKisi', 'esyaId', 'neden', 'uid', 'ad', 'durum', 'olusturma'])
        && yeni().uid == benim() && yeni().durum == 'acik' && yeni().olusturma == request.time
        && yeni().tur in ['esya', 'soru', 'yorum', 'profil']
        && yeni().hedefId is string && yeni().hedefId.size() <= 128
        && yeni().hedefKisi is string && yeni().hedefKisi.size() <= 128
        && yeni().esyaId is string && yeni().esyaId.size() <= 128
        && yeni().neden is string && yeni().neden.size() >= 3 && yeni().neden.size() <= 300
        && yeni().ad is string && yeni().ad.size() <= 40;
      allow update: if dolapAdmin() && degisenler().hasOnly(['durum', 'kapanis', 'kapatan'])
        && yeni().durum == 'cozuldu' && yeni().kapanis == request.time && yeni().kapatan == request.auth.token.email;
      allow delete: if tamYetkili();
    }

    match /dolapFotolar/{foto} {
      allow read: if true;
      allow create: if girisli() && !kisitli()
        && yeni().keys().hasOnly(['sahipId', 'veri', 'olusturma'])
        && yeni().sahipId == benim()
        && yeni().veri is string && yeni().veri.size() <= 950000
        && yeni().olusturma == request.time;
      allow delete: if girisli() && (resource.data.sahipId == benim() || dolapAdmin());
    }

    /* Herkese açık profil: ad, foto, şehir, hakkında. Telefon/adres/e-posta burada TUTULMAZ. */
    match /dolapProfiller/{kimlik} {
      allow read: if true;
      allow create, update: if (girisli() && kimlik == benim()
          && yeni().keys().hasOnly(['ad', 'foto', 'sehir', 'hakkimda', 'katilma', 'guncelleme'])
          && yeni().get('ad', '') is string && yeni().get('ad', '').size() <= 80
          && yeni().get('foto', '') is string && yeni().get('foto', '').size() <= 600
          && yeni().get('sehir', '') is string && yeni().get('sehir', '').size() <= 40
          && yeni().get('hakkimda', '') is string && yeni().get('hakkimda', '').size() <= 300
          && temizMetin(yeni().get('hakkimda', '')) && temizMetin(yeni().get('sehir', ''))
          && (!yeni().keys().hasAny(['katilma']) || (yeni().katilma is timestamp && yeni().katilma <= request.time)))
        || (dolapAdmin() && resource != null && degisenler().hasOnly(['hakkimda']) && yeni().hakkimda == '');
      allow delete: if girisli() && (kimlik == benim() || tamYetkili());
    }

    /* Sadakat puanı kaydı: belge kimliği kiralama kimliği. Yalnız eşya sahibi, kiralamayı
       "teslim_edildi"den "iade_edildi"ye geçirdiği aynı yazımda oluşturabilir; alanlar kiralamayla aynı olmalı. */
    function puanGecerli(kira) {
      let once = get(/databases/$(database)/documents/dolapKiralamalar/$(kira)).data;
      let sonra = getAfter(/databases/$(database)/documents/dolapKiralamalar/$(kira)).data;
      let p = request.resource.data;
      return once.durum in ['teslim_edildi', 'iade_yolda'] && sonra.durum == 'iade_edildi' && once.sahipId == benim()
        && p.keys().hasOnly(['kiraciId', 'kiraciAd', 'sahipId', 'esyaId', 'esyaBaslik', 'bitis', 'iadeDurum', 'zaman'])
        && p.kiraciId == once.kiraciId && p.kiraciAd == once.kiraciAd && p.sahipId == once.sahipId
        && p.esyaId == once.esyaId && p.esyaBaslik == once.esyaBaslik && p.bitis == once.bitis
        && p.iadeDurum == sonra.get('iadeDurum', 'sorunsuz') && p.zaman == request.time;
    }
    match /dolapPuanlar/{kira} {
      allow read: if true;
      allow create: if girisli() && puanGecerli(kira);
      allow update, delete: if tamYetkili();
    }

    /* Üye kaydı: profil, telefon, adresler, kayıtlı filtreler, tercihler.
       Kişi kendi kaydını yazar; adminler okur (kullanıcı listesi). Kart bilgisi TUTULMAZ. */
    match /dolapUyeler/{kimlik} {
      allow read: if girisli() && (kimlik == benim() || dolapAdmin());
      allow create, update: if girisli() && kimlik == benim()
        && yeni().keys().hasOnly(['uid', 'ad', 'eposta', 'foto', 'telefon', 'adresler', 'filtreler',
                                  'bildirimEposta', 'istatistikIzni', 'ilkGiris', 'sonGiris', 'iban', 'ibanAd', 'bildirimOkuma', 'engellenenler'])
        && yeni().get('engellenenler', []) is list && yeni().get('engellenenler', []).size() <= 500
        && (yeni().get('bildirimOkuma', 0) is int)
        && yeni().get('iban', '') is string && yeni().get('iban', '').size() <= 34
        && yeni().get('ibanAd', '') is string && yeni().get('ibanAd', '').size() <= 80
        && yeni().uid == benim()
        && yeni().eposta == request.auth.token.email
        && yeni().get('telefon', '') is string && yeni().get('telefon', '').size() <= 30
        && yeni().get('adresler', []) is list && yeni().get('adresler', []).size() <= 10
        && yeni().get('filtreler', []) is list && yeni().get('filtreler', []).size() <= 20;
      allow delete: if girisli() && (kimlik == benim() || tamYetkili());
    }

    /* Roller: belge kimliği Gmail adresi. rol: 'admin' | 'kisitli' */
    match /dolapRoller/{eposta} {
      allow read: if girisli() && (eposta == request.auth.token.email || dolapAdmin());
      allow create: if yeni().keys().hasOnly(['rol', 'neden', 'atayan', 'zaman'])
        && yeni().neden is string && yeni().neden.size() <= 200
        && yeni().atayan == request.auth.token.email && yeni().zaman == request.time
        && eposta != 'sercansozer20@gmail.com'
        && ((tamYetkili() && yeni().rol in ['admin', 'kisitli'])
            || (dolapAdmin() && yeni().rol == 'kisitli'));
      allow update: if yeni().keys().hasOnly(['rol', 'neden', 'atayan', 'zaman'])
        && yeni().atayan == request.auth.token.email && yeni().zaman == request.time
        && ((tamYetkili() && yeni().rol in ['admin', 'kisitli'])
            || (dolapAdmin() && eski().rol == 'kisitli' && yeni().rol == 'kisitli'));
      allow delete: if tamYetkili() || (dolapAdmin() && eski().rol == 'kisitli');
    }

    /* Soru-cevap: kullanıcı kendi konusunu açar ve yazar; adminler okur, yanıtlar, kapatır.
       Mesajlar dizide tutulur; eski mesajlar silinemez/değiştirilemez (hasAll). */
    match /dolapSohbet/{konu} {
      allow read: if girisli() && (resource.data.uid == benim() || dolapAdmin());
      allow create: if girisli()
        && yeni().keys().hasOnly(['uid', 'ad', 'eposta', 'konu', 'durum', 'mesajlar', 'sonZaman', 'adminOkudu', 'kullaniciOkudu'])
        && yeni().uid == benim() && yeni().eposta == request.auth.token.email
        && yeni().ad is string && yeni().ad.size() <= 80
        && yeni().konu is string && yeni().konu.size() <= 120
        && yeni().durum == 'acik' && yeni().adminOkudu == false && yeni().kullaniciOkudu == true
        && yeni().mesajlar is list && yeni().mesajlar.size() == 1
        && yeni().mesajlar[0].kimden == 'kullanici' && yeni().mesajlar[0].metin.size() <= 2000
        && yeni().sonZaman == request.time;
      allow update: if girisli() && (
        (eski().uid == benim() && degisenler().hasOnly(['kullaniciOkudu']))
        || (dolapAdmin() && degisenler().hasOnly(['adminOkudu']))
        || (eski().uid == benim() && eski().durum != 'kapali'
            && degisenler().hasOnly(['mesajlar', 'durum', 'sonZaman', 'adminOkudu'])
            && yeni().sonZaman == request.time && yeni().durum == 'acik' && yeni().adminOkudu == false
            && yeni().mesajlar.size() == eski().mesajlar.size() + 1 && yeni().mesajlar.size() <= 200
            && yeni().mesajlar.hasAll(eski().mesajlar)
            && yeni().mesajlar[yeni().mesajlar.size() - 1].kimden == 'kullanici'
            && yeni().mesajlar[yeni().mesajlar.size() - 1].metin.size() <= 2000)
        || (dolapAdmin()
            && degisenler().hasOnly(['mesajlar', 'durum', 'sonZaman', 'adminOkudu', 'kullaniciOkudu'])
            && yeni().sonZaman == request.time && yeni().durum in ['acik', 'yanitlandi', 'kapali']
            && yeni().mesajlar.hasAll(eski().mesajlar) && yeni().mesajlar.size() <= 200
            && (yeni().mesajlar.size() == eski().mesajlar.size()
                || (yeni().mesajlar.size() == eski().mesajlar.size() + 1
                    && yeni().mesajlar[yeni().mesajlar.size() - 1].kimden == 'admin')))
      );
      allow delete: if tamYetkili();
    }

    /* Gezinti kayıtları (yalnız izin veren ziyaretçiden). Herkes yazar, şekil zorunlu;
       yalnız adminler okur. Liste sorgusu tek alan (zaman >=) → dizin gerekmez. */
    match /dolapOlaylar/{olay} {
      allow create: if yeni().keys().hasOnly(['tur', 'sayfa', 'esyaId', 'marka', 'kategori', 'baslik',
                                             'ara', 'oturum', 'uid', 'ad', 'zaman'])
        && yeni().tur in ['sayfa', 'esya', 'arama', 'giris']
        && yeni().sayfa is string && yeni().sayfa.size() <= 60
        && yeni().esyaId is string && yeni().esyaId.size() <= 60
        && yeni().marka is string && yeni().marka.size() <= 40
        && yeni().kategori is string && yeni().kategori.size() <= 20
        && yeni().baslik is string && yeni().baslik.size() <= 80
        && yeni().ara is string && yeni().ara.size() <= 60
        && yeni().oturum is string && yeni().oturum.size() <= 40
        && yeni().ad is string && yeni().ad.size() <= 80
        && (yeni().uid == '' || (girisli() && yeni().uid == benim()))
        && yeni().zaman == request.time;
      allow read: if dolapAdmin();
      allow delete: if tamYetkili();
    }

    /* Öne çıkarma (boost): sahip talep açar ve ödemeyi bildirir; admin ödemeyi onaylayınca
       süre başlar (bitiş = şimdi + paket süresi, 5 dk tolerans). Paket süreleri sabit. */
    function paketGecerli(d) {
      return (d.paket == 'saatlik' && d.saat == 1) || (d.paket == 'gunluk' && d.saat == 24)
          || (d.paket == 'haftalik' && d.saat == 168) || (d.paket == 'aylik' && d.saat == 720);
    }
    match /dolapBoostlar/{boost} {
      allow read: if girisli() && (resource.data.sahipId == benim() || dolapAdmin());
      allow create: if girisli() && !kisitli()
        && yeni().keys().hasOnly(['esyaId', 'esyaBaslik', 'esyaFoto', 'sahipId', 'sahipAd', 'paket', 'saat', 'fiyat',
                                  'durum', 'baslangic', 'bitis', 'olusturma', 'guncelleme'])
        && yeni().sahipId == benim()
        && get(/databases/$(database)/documents/dolapEsyalar/$(yeni().esyaId)).data.sahipId == benim()
        && paketGecerli(yeni())
        && yeni().fiyat is number && yeni().fiyat > 0 && yeni().fiyat <= 100000
        && yeni().durum == 'odeme_bekliyor' && yeni().baslangic == null && yeni().bitis == null
        && yeni().esyaBaslik is string && yeni().esyaBaslik.size() <= 80
        && yeni().esyaFoto is string && yeni().esyaFoto.size() <= 120000
        && yeni().sahipAd is string && yeni().sahipAd.size() <= 80
        && yeni().olusturma == request.time && yeni().guncelleme == request.time;
      allow update: if girisli() && yeni().guncelleme == request.time && (
        (eski().sahipId == benim() && eski().durum == 'odeme_bekliyor'
          && yeni().durum in ['odeme_bildirildi', 'iptal'] && degisenler().hasOnly(['durum', 'guncelleme']))
        || (dolapAdmin() && eski().durum == 'odeme_bildirildi'
          && yeni().durum in ['odeme_bekliyor', 'reddedildi'] && degisenler().hasOnly(['durum', 'guncelleme']))
        || (dolapAdmin() && eski().durum == 'odeme_bildirildi' && yeni().durum == 'aktif'
          && degisenler().hasOnly(['durum', 'guncelleme', 'baslangic', 'bitis'])
          && yeni().baslangic == request.time
          && yeni().bitis > request.time + duration.value(eski().saat * 60 - 5, 'm')
          && yeni().bitis < request.time + duration.value(eski().saat * 60 + 5, 'm'))
      );
      allow delete: if tamYetkili();
    }

    /* Jeton ve Satıcı Pro: bakiyeyi, işlem geçmişini ve Pro süresini YALNIZ sunucu
       (functions/jeton.js, Admin SDK) yazar; Apple satın alımı orada doğrulanır.
       dolapJetonlar/{uid}: { bakiye, proBitis } · dolapJetonIslem: hareket defteri
       dolapPro/{uid}: { bitis } herkese açık (Pro rozeti) · dolapApple*: yalnız sunucu */
    match /dolapJetonlar/{kimlik} {
      allow read: if girisli() && (kimlik == benim() || dolapAdmin());
      allow write: if false;
    }
    match /dolapJetonIslem/{islem} {
      allow read: if girisli() && (resource.data.uid == benim() || dolapAdmin());
      allow write: if false;
    }
    match /dolapPro/{kimlik} {
      allow read: if true;
      allow write: if false;
    }
    match /dolapAppleIslem/{islem} {
      allow read, write: if false;
    }
    match /dolapAppleAbonelik/{islem} {
      allow read, write: if false;
    }

    /* Destek postası alıcıları: tarayıcı herkese açık hedeflere gönderir; hangi hedefin
       kime ait olduğu yalnız adminlere açık. Yazmayı adminler yapar. */
    match /ayarlarGenel/destek {
      allow read: if true;
      allow write: if dolapAdmin() && yeni().keys().hasOnly(['hedefler'])
        && yeni().hedefler is list && yeni().hedefler.size() <= 20;
    }
    match /ayarlarGizli/destek {
      allow read: if dolapAdmin();
      allow write: if dolapAdmin() && yeni().keys().hasOnly(['alicilar'])
        && yeni().alicilar is list && yeni().alicilar.size() <= 20;
    }

    /* Örnek (demo) veri: elif.html?demo=1 buradan okur. Gerçek verilerden ayrı.
       Herkes okur; yalnız tam yetkili yükler / siler (panel → Veri yönetimi). */
    match /demoVeri/{belge} {
      allow read: if true;
      allow write: if tamYetkili();
    }

    /* Açıkça eşleşmeyen her yol kapalıdır (varsayılan zaten budur; niyet beyanı). */
    match /{belge=**} {
      allow read, write: if false;
    }
  }
}
